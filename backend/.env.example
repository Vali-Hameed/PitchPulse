# ---------------------------------------------------------------------------
# PitchPulse Studio — backend environment
# Copy to backend/.env (or export in your shell) and fill in to enable Azure.
# When the key OR endpoint is blank, the deterministic engine is used.
# ---------------------------------------------------------------------------

# Azure OpenAI Service (GPT-4o deployment)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Any single LLM call slower than this falls back to the deterministic engine
LLM_TIMEOUT_SEC=2.5

# Cooldown (seconds of simulated play) between organic key-moment overlays
ORGANIC_COOLDOWN_SEC=8
SCENARIO_POST_COOLDOWN_SEC=12

# Comma separated list, or * for any origin
CORS_ORIGINS=*

# Shown in the "Azure Proof" engine pill, e.g. "ACA-WestUS".
# CONTAINER_APP_NAME is injected automatically by Azure Container Apps.
DEPLOYMENT_REGION=WestUS

PORT=8000
