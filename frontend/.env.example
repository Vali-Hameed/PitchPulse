# ---------------------------------------------------------------------------
# PitchPulse Studio — Frontend Environment Configuration
# Copy to frontend/.env.local or frontend/.env when running Next.js locally.
# ---------------------------------------------------------------------------

# Public Backend API URL used by browser EventSource (SSE) and REST calls
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal Backend URL used by Next.js server-side rewrites (inside Docker: http://backend:8000)
INTERNAL_BACKEND_URL=http://localhost:8000

